# Copy this file to .env before running or building the frontend.

# Where the backend API lives. For local development with the backend
# running via `uvicorn main:app --reload --port 8000`, the default below
# is correct. Once the backend is deployed, set this to its live URL
# (e.g. https://your-backend.up.railway.app) and rebuild.
REACT_APP_API_URL=http://localhost:8000
